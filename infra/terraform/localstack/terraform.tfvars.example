## Example terraform.tfvars for infra/terraform/localstack
# Copy this file to terraform.tfvars and fill values before running the deploy script.

# AWS region
aws_region = "us-east-1"

aws_access_key = "test"
aws_secret_key = "test"

# Stage name for API Gateway
stage_name = "dev"

# API and Lambda names
api_name = "local-api-gateway-v1"
lambda_name = "fiap-api-authorizer"

# When true, API methods authorization is disabled (useful for local dev)
# Set to "true" or "false"
allow_dev_stage_bypass = "false"

# Internal container port used by services (matches docker-compose)
container_port = "80"

# Obrigatório (a menos que use jwks_metadata_address): id do projeto Firebase usado pelo
# authorizer para validar os tokens. Sem nenhum dos dois, o authorizer nega tudo (fail-closed).
firebase_project_id = "<seu-projeto-firebase>"

# Opcional: sobrescreve a URL do documento OpenID/JWKS (use para outro provedor de identidade).
# Deixe vazio para usar o Firebase a partir de firebase_project_id.
jwks_metadata_address = ""
